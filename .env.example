LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=replace-with-your-own-api-key
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Use enhanced to enable mixed-language BM25, bounded reranking and evidence selection.
RETRIEVAL_MODE=baseline
RETRIEVAL_CANDIDATES=24
RETRIEVAL_DIVERSITY_MARGIN=0.04
PORT=8778
RUN_TIMEOUT_SECONDS=240
# Optional: documented tariff only; otherwise cost is reported as unknown.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
PRICING_DATE=
